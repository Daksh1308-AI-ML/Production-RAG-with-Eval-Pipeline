# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=qwen2.5:7b

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=sec_filings
QDRANT_EMBEDDING_DIM=768

# Retrieval Configuration
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6
INITIAL_K=20
FINAL_K=5

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Evaluation Configuration
# Judge via local Ollama when JUDGE_API_KEY is empty.
# Judge via any OpenAI-compatible hosted API when JUDGE_API_KEY is set.
# OpenRouter free models: https://openrouter.ai/keys (50 req/day free; 1000/day after one-time $10 top-up)
# Pin a SPECIFIC free model — the `openrouter/free` router randomizes per call
# and breaks ragas' strict per-step JSON schema. nemotron-3.5-lightning is the
# current reliable free pick with structured-output support.
# JUDGE_MODEL=nvidia/nemotron-3.5-lightning:free
# JUDGE_BASE_URL=https://openrouter.ai/api/v1
# JUDGE_API_KEY=sk-or-...
JUDGE_MODEL=qwen2.5:7b
JUDGE_BASE_URL=
JUDGE_API_KEY=
EVAL_DATASET_PATH=data/evaluation/eval_dataset.json

# Langfuse Monitoring (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# SEC EDGAR Configuration
SEC_COMPANY_NAME=ResearchProject
SEC_EMAIL=research@example.com

# Phase 2: Multi-tenancy (payload filter on a single Qdrant collection)
TENANT_ID=default

# Phase 2: Semantic cache (Qdrant collection storing query->answer)
CACHE_ENABLED=true
CACHE_THRESHOLD=0.92
CACHE_COLLECTION=semantic_cache

# Phase 2: API gateway auth (comma-separated static keys, X-API-Key header)
API_KEYS=dev-key-change-me
API_PORT=8000
